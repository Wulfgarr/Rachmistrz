@page "/invoices/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Forms
@using Rachmistrz.Web.DTOs
@using Rachmistrz.Web.Services
@using Rachmistrz.Web.Models

@inject InvoiceService InvoiceService
@inject SupplierService SupplierService
@inject BranchService BranchService
@inject CostCategoryService CostCategoryService
@inject NavigationManager NavigationManager

<PageTitle>Edit Invoice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Edytuj fakturę
</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_model is null)
{
    <MudAlert Severity="Severity.Error">
        Nie znaleziono faktury.
    </MudAlert>

    <MudButton Href="/invoices"
               Variant="Variant.Outlined"
               Color="Color.Primary"
               Class="mt-4">
        Wróć do listy faktur
    </MudButton>
}
else
{
    if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_errorMessage
        </MudAlert>
    }

    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.InvoiceNumber"
                             Label="Numer faktury"
                             For="@(() => _model.InvoiceNumber)"
                             Required="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                             @bind-Value="_model.SupplierId"
                             Label="Dostawca"
                             For="@(() => _model.SupplierId)"
                             Required="true">
                        @foreach (var supplier in _suppliers)
                        {
                            <MudSelectItem T="int?" Value="@((int?)supplier.Id)">
                                @supplier.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                             @bind-Value="_model.BranchId"
                             Label="Oddział"
                             For="@(() => _model.BranchId)"
                             Required="true">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem T="int?" Value="@((int?)branch.Id)">
                                @branch.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="int?"
                             @bind-Value="_model.CostCategoryId"
                             Label="Kategoria Kosztów"
                             For="@(() => _model.CostCategoryId)"
                             Required="true">
                        @foreach (var costCategory in _costCategories)
                        {
                            <MudSelectItem T="int?" Value="@((int?)costCategory.Id)">
                                @costCategory.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_model.IssueDate"
                                   Label="Data wystawienia."
                                   For="@(() => _model.IssueDate)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_model.ReceivedDate"
                                   Label="Data otrzymania."
                                   For="@(() => _model.ReceivedDate)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_model.DueDate"
                                   Label="Termin płatności."
                                   For="@(() => _model.DueDate)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.NetAmount"
                                     Label="Kwota netto."
                                     For="@(() => _model.NetAmount)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.VatAmount"
                                     Label="Kwota VAT."
                                     For="@(() => _model.VatAmount)" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.GrossAmount"
                                     Label="Kwota brutto."
                                     For="@(() => _model.GrossAmount)" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Opis"
                                  Lines="4"
                                  For="@(() => _model.Description)" />
                </MudItem>

                <MudItem xs="12" Class="d-flex gap-2">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary">
                        Zapisz zmiany
                    </MudButton>

                    <MudButton Href="@($"/Invoices/{Id}")"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary" >
                               Anuluj
                    </MudButton>
                </MudItem>

            </MudGrid>

        </MudPaper>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EditInvoiceDto? _model;
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;

    private List<Supplier> _suppliers = [];
    private List<Branch> _branches = [];
    private List<CostCategory> _costCategories = [];

    protected override async Task OnInitializedAsync()
    {
        _suppliers = await SupplierService.GetSuppliersAsync();
        _branches = await BranchService.GetBranchesAsync();
        _costCategories = await CostCategoryService.GetCostCategoriesAsync();

        _model = await InvoiceService.GetInvoiceForEditAsync(Id);

        _isLoading = false;
    }

    private async Task HandleValidSubmit()
    {
        if (_model is null)
        {
            return;
        }

        try
        {
            _errorMessage = string.Empty;

            var updated = await InvoiceService.UpdateInvoiceAsync(_model);

            if (!updated)
            {
                _errorMessage = "Nie znaleziono faktury do edycji.";
                return;
            }

            NavigationManager.NavigateTo($"/invoices/{_model.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Nie udało się zapisać zmian: {ex.Message}";
        }
    }




}
