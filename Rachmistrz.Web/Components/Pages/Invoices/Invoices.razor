@page "/invoices"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Rachmistrz.Web.Data
@using Rachmistrz.Web.DTOs
@using Rachmistrz.Web.Enums
@using Rachmistrz.Web.Services
@using Rachmistrz.Web.Models

@inject InvoiceService InvoiceService
@inject SupplierService SupplierService
@inject BranchService BranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Invoices</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <MudText Typo="Typo.h4" Class="mb-4">
        Faktury
    </MudText>

    <MudButton Href="/invoices/create"
               Variant="Variant.Filled"
               Color="Color.Primary">
        Dodaj fakturę
    </MudButton>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-3">
        Filtry
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_filter.InvoiceNumber"
                          Label="Numer faktury" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="InvoiceStatus?"
                       @bind-Value="_filter.Status"
                       Label="Status">
                <MudSelectItem T="InvoiceStatus?" Value="null">
                    Wszystkie
                </MudSelectItem>

                @foreach (var status in Enum.GetValues<InvoiceStatus>())
                {
                    <MudSelectItem T="InvoiceStatus?" Value="@status">
                        @status
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="int?"
                       @bind-Value="_filter.SupplierId"
                       Label="Dostawca">
                <MudSelectItem T="int?" Value="null">
                    Wszyscy
                </MudSelectItem>

                @foreach (var supplier in _suppliers)
                {
                    <MudSelectItem T="int?" Value="@((int?)supplier.Id)">
                        @supplier.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="int?"
                       @bind-Value="_filter.BranchId"
                       Label="Oddział">
                <MudSelectItem T="int?" Value="null">
                    Wszystkie
                </MudSelectItem>

                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="int?" Value="@((int?)branch.Id)">
                        @branch.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudDatePicker @bind-Date="_filter.DueDateFrom"
                           Label="Termin płatności od" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudDatePicker @bind-Date="_filter.DueDateTo"
                           Label="Termin płatności do" />
        </MudItem>

        <MudItem xs="12" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ApplyFiltersAsync">
                Filtruj
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="ClearFiltersAsync">
                Wyczyść
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_invoices.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Brak faktur do wyświetlenia.
    </MudAlert>
}
else
{
    <MudTable Items="_invoices" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Numer faktury</MudTh>
            <MudTh>Dostawca</MudTh>
            <MudTh>Oddział</MudTh>
            <MudTh>Kategoria</MudTh>
            <MudTh>Kwota brutto</MudTh>
            <MudTh>Termin płatności</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Akcje</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Numer faktury">@context.InvoiceNumber</MudTd>
            <MudTd DataLabel="Dostawca">@context.SupplierName</MudTd>
            <MudTd DataLabel="Oddział">@context.BranchName</MudTd>
            <MudTd DataLabel="Kategoria">@context.CostCategoryName</MudTd>
            <MudTd DataLabel="Kwota brutto">@context.GrossAmount.ToString("C")</MudTd>
            <MudTd DataLabel="Termin płatności">@context.DueDate.ToShortDateString()</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Color="GetStatusColor(context.Status)"
                         Size="Size.Small">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Akcje">
                <MudButton Href="@($"/invoices/{context.Id}")"
                Variant="Variant.Outlined"
                Color="Color.Primary"
                Size="Size.Small">
                    Szczegóły
                </MudButton>
                </MudTd>
        </RowTemplate>
    </MudTable>
}


@code {
    private InvoiceFilterDto _filter = new();


    private List<InvoiceListItemDto> _invoices = [];
    private List<Supplier> _suppliers = [];
    private List<Branch> _branches = [];

    private string _currentUserId = string.Empty;
    private int? _currentUserBranchId;
    private IList<string> _currentUserRoles = [];

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authenticationState.User);

        if (user is null)
        {
            _invoices = [];
            _isLoading = false;
            return;
        }

        _currentUserId = user.Id;
        _currentUserBranchId = user.BranchId;
        _currentUserRoles = await UserManager.GetRolesAsync(user);

        _suppliers = await SupplierService.GetSuppliersAsync();
        _branches = await BranchService.GetBranchesAsync();

        await LoadInvoicesAsync();

        _isLoading = false;
    }
    
    private async Task LoadInvoicesAsync()
    {
        _invoices = await InvoiceService.GetInvoicesAsync(
            _currentUserId,
            _currentUserBranchId,
            _currentUserRoles,
            _filter);
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadInvoicesAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _filter = new InvoiceFilterDto();

        await LoadInvoicesAsync();
    }

    private static Color GetStatusColor(Rachmistrz.Web.Enums.InvoiceStatus status)
    {
        return status switch
        {
            Rachmistrz.Web.Enums.InvoiceStatus.Draft => Color.Default,
            Rachmistrz.Web.Enums.InvoiceStatus.Submitted => Color.Info,
            Rachmistrz.Web.Enums.InvoiceStatus.UnderReview => Color.Warning,
            Rachmistrz.Web.Enums.InvoiceStatus.Approved => Color.Success,
            Rachmistrz.Web.Enums.InvoiceStatus.Rejected => Color.Error,
            Rachmistrz.Web.Enums.InvoiceStatus.Booked => Color.Primary,
            Rachmistrz.Web.Enums.InvoiceStatus.Paid => Color.Success,
            Rachmistrz.Web.Enums.InvoiceStatus.Cancelled => Color.Default,
            _ => Color.Default

        };
    }
}
