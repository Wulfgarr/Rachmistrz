@page "/invoices/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Rachmistrz.Web.DTOs
@using Rachmistrz.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Rachmistrz.Web.Data
@using Rachmistrz.Web.Enums

@inject InvoiceService InvoiceService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<h3>Szczegóły faktury</h3>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_invoice is null)
{
    <MudAlert Severity="Severity.Error">
        Nie znaleziono faktury.
    </MudAlert>

    <MudButton Href="/invoices"
               Variant="Variant.Outlined"
               Color="Color.Primary"
               Class="mt-4">
        Wróć do listy faktur
    </MudButton>
}
else
{

    <div class="d-flex justify-content-between align-items-center mb-4">
        <MudText Typo="Typo.h4" Class="mb-4">
            Faktura @_invoice.InvoiceNumber
        </MudText>

        <MudButton Href="@($"/invoices/{_invoice.Id}/edit")"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Edytuj fakturę
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_errorMessage
        </MudAlert>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            Dane podstawowe
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText><strong>Numer faktury:</strong> @_invoice.InvoiceNumber</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText><strong>Status:</strong> @_invoice.Status</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText><strong>Dostawca:</strong> @_invoice.SupplierName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText><strong>Nip dostawcy:</strong> @_invoice.SupplierNip</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText><strong>Oddział:</strong> @_invoice.BranchName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText><strong>Kod oddziału:</strong> @_invoice.BranchCode</MudText>
            </MudItem>

            <MudItem>
                <MudText><strong>Kategoria kosztów:</strong> @_invoice.CostCategoryName</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            Daty
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudText><strong>Data wystawienia:</strong> @_invoice.IssueDate.ToString("dd.MM.yyyy")</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>Data otrzymania:</strong> @_invoice.ReceivedDate.ToString("dd.MM.yyyy")</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>Termin płatności:</strong> @_invoice.DueDate.ToString("dd.MM.yyyy")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            Kwoty
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudText><strong>Netto:</strong> @_invoice.NetAmount.ToString("N2")</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>VAT:</strong> @_invoice.VatAmount.ToString("N2")</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>Brutto:</strong> @_invoice.GrossAmount.ToString("N2")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            Opis
        </MudText>

        @if (string.IsNullOrWhiteSpace(_invoice.Description))
        {
            <MudText Color="Color.Secondary">
                Brak opisu.
            </MudText>
        }
        else
        {
            <MudText>
                @_invoice.Description
            </MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            Informacje systemowe
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudText><strong>Utworzona przez:</strong> @_invoice.CreatedByUserEmail</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>Data utworzenia</strong> @_invoice.CreatedAt.ToString("dd.MM.yyyy")</MudText>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudText><strong>Ostatnia aktualizacja:</strong> @(_invoice.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Brak")</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (GetAvailableStatusActions().Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">
                Akcje statusu
            </MudText>

            <MudStack Row="true" Spacing="2">
                @foreach (var action in GetAvailableStatusActions())
                {
                    <MudButton Variant="Variant.Filled"
                               Color="@action.Color"
                               Disabled="_isChangingStatus"
                               OnClick="@(() => ChangeStatusAsync(action.NewStatus, action.Description))">
                        @action.Label
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    }

    <MudButton Href="/invoices"
               Variant="Variant.Outlined"
               Color="Color.Primary">
        Wróć do listy faktur
    </MudButton>


}

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDetailsDto? _invoice;
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private bool _isChangingStatus;

    private sealed record StatusAction(
    InvoiceStatus NewStatus,
    string Label,
    string Description,
    Color Color);

    private List<StatusAction> GetAvailableStatusActions()
    {
        if (_invoice is null)
        {
            return [];
        }

        return _invoice.Status switch
        {
            InvoiceStatus.Draft =>
            [
                new StatusAction(
                InvoiceStatus.Submitted,
                "Wyślij do obsługi",
                "Faktura została wysłana do obsługi.",
                Color.Primary),

            new StatusAction(
                InvoiceStatus.Cancelled,
                "Anuluj fakturę",
                "Faktura została anulowana.",
                Color.Error)
            ],

            InvoiceStatus.Submitted =>
            [
                new StatusAction(
                InvoiceStatus.UnderReview,
                "Przekaż do weryfikacji",
                "Faktura została przekazana do weryfikacji.",
                Color.Primary),

            new StatusAction(
                InvoiceStatus.Cancelled,
                "Anuluj fakturę",
                "Faktura została anulowana.",
                Color.Error)
            ],

            InvoiceStatus.UnderReview =>
            [
                new StatusAction(
                InvoiceStatus.Approved,
                "Zatwierdź",
                "Faktura została zatwierdzona.",
                Color.Success),

            new StatusAction(
                InvoiceStatus.Rejected,
                "Odrzuć",
                "Faktura została odrzucona.",
                Color.Error)
            ],

            InvoiceStatus.Approved =>
            [
                new StatusAction(
                InvoiceStatus.Booked,
                "Oznacz jako zaksięgowaną",
                "Faktura została oznaczona jako zaksięgowana.",
                Color.Primary)
            ],

            InvoiceStatus.Booked =>
            [
                new StatusAction(
                InvoiceStatus.Paid,
                "Oznacz jako zapłaconą",
                "Faktura została oznaczona jako zapłacona.",
                Color.Success)
            ],

            InvoiceStatus.Rejected =>
            [
                new StatusAction(
                InvoiceStatus.Draft,
                "Przywróć do roboczych",
                "Faktura została przywrócona do statusu roboczego.",
                Color.Warning),

            new StatusAction(
                InvoiceStatus.Cancelled,
                "Anuluj fakturę",
                "Faktura została anulowana.",
                Color.Error)
            ],

            _ => []
        };
    }

    private async Task ChangeStatusAsync(InvoiceStatus newStatus, string description)
    {
        if (_invoice is null)
        {
            return;
        }

        try
        {
            _isChangingStatus = true;
            _errorMessage = string.Empty;

            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authenticationState.User);

            if (user is null)
            {
                _errorMessage = "Musisz być zalogowany, aby zmienić status faktury.";
                return;
            }

            var changed = await InvoiceService.ChangeStatusAsync(
                _invoice.Id,
                newStatus,
                user.Id,
                description);

            if (!changed)
            {
                _errorMessage = "Nie znaleziono faktury.";
                return;
            }

            // Po zmianie statusu pobieramy świeże dane, żeby UI pokazał aktualny status i nowe dostępne akcje.
            _invoice = await InvoiceService.GetInvoiceDetailsAsync(_invoice.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Nie udało się zmienić statusu faktury: {ex.Message}";
        }
        finally
        {
            _isChangingStatus = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _invoice = await InvoiceService.GetInvoiceDetailsAsync(Id);
        _isLoading = false;
    }


}
