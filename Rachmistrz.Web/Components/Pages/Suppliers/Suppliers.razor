@page "/suppliers"

@using Rachmistrz.Web.Models
@using Rachmistrz.Web.Services

@inject SupplierService SupplierService

<PageTitle>Suppliers</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Dostawcy
</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true"/>
}
else if (_suppliers.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        Brak dostawców do wyświetlenia.
    </MudAlert>
}
else
{
    <MudTable Items="_suppliers" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Nazwa</MudTh>
            <MudTh>NIP</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Adres</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nazwa">@context.Name</MudTd>
            <MudTd DataLabel="NIP">@context.Nip</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Telefon">@context.Phone</MudTd>
            <MudTd DataLabel="Adres">@context.Address</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                    {
                     <MudChip T="string"
                            Color="Color.Success"
                            Size="Size.Small">
                            Aktywny
                     </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                            Color="Color.Success"
                        Size="Size.Small">
                        Nieaktywny
                        </MudChip>
                    }
                </MudTd>
        </RowTemplate>
    </MudTable>
}

        @code {
        private List<Supplier> _suppliers = [];
        private bool _isLoading = true;

        protected override async Task OnInitializedAsync()
        {
            _suppliers = await SupplierService.GetSuppliersAsync();
            _isLoading = false;
        }
}
